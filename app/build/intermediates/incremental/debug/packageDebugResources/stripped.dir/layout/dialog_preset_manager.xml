<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_folder"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Pilih &amp; Kelola Preset Shortcut"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_dialog_close_x"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tutup"
            android:src="@drawable/ic_clear"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="Pilih berkas preset yang ingin dipasang ke keyboard aktif di HP. Setiap file tersimpan mandiri dan tidak saling menimpa."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.2" />

    <!-- Daftar Preset Tersimpan -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dialog_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="ifContentScrolls"
        tools:listitem="@layout/item_preset_dialog" />

    <!-- Keadaan Kosong (Empty State) -->
    <TextView
        android:id="@+id/tv_empty_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Belum ada berkas preset tersimpan. Tekan tombol di bawah untuk mengimpor file."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Action Bar Bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_import_new"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:text="+ Impor Berkas Baru"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_close"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/key_background_normal"
            android:paddingVertical="10dp"
            android:text="Tutup"
            android:textColor="@color/text_primary"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
