<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Migrasi / Import dari Perfect Keyboard"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Dukung berkas ekspor Perfect Keyboard (.xml, .csv, .txt, .backup) atau tempel teks langsung."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Opsi 1: Pilih File dari HP -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_choose_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/key_background_normal"
        android:text="📁 Pilih File Backup Perfect Keyboard"
        android:textColor="@color/text_primary"
        app:cornerRadius="8dp" />

    <TextView
        android:id="@+id/tv_file_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/candidate_text_highlight"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Pemisah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:text="ATAU TEMPEL TEKS"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#33FFFFFF" />
    </LinearLayout>

    <!-- Opsi 2: Tempel teks langsung -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColorHint="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_raw_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tempel data backup di sini (XML / CSV / Baris teks)"
            android:lines="4"
            android:maxLines="8"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_preview_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Pratinjau: 0 shortcut terdeteksi"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
