<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_title_add"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColorHint="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_input_shortcut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_shortcut"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:inputType="textNoSuggestions" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_input_expansion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_expansion"
            android:textColor="@color/text_primary"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mode Ekspansi Teks"
        android:textColor="@color/candidate_text_highlight"
        android:textSize="12sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_add_expansion_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/rb_add_mode_instant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instan / Tanpa Spasi (e.g. /id langsung ekspansi)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_add_mode_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Dengan Spasi / Enter (e.g. /id menunggu spasi/enter)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </RadioGroup>

</LinearLayout>
