<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_preset_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="3dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#22FFFFFF"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp">

        <!-- Radio Indicator untuk Status Aktif -->
        <RadioButton
            android:id="@+id/rb_preset_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:clickable="false"
            android:focusable="false"
            android:buttonTint="@color/accent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Tombol Hapus Preset -->
        <ImageButton
            android:id="@+id/btn_delete_preset"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hapus Preset"
            android:padding="5dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/key_action_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Nama Preset (Row 1) -->
        <TextView
            android:id="@+id/tv_preset_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:maxLines="1"
            android:text="Perfect Keyboard"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/rb_preset_active"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_preset"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Row 2: Jumlah Shortcut, Badge Sumber (Cloud/XML), dan Badge Status Aktif -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@id/rb_preset_active"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_preset"
            app:layout_constraintTop_toBottomOf="@id/tv_preset_name"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_preset_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="247 shortcut"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_preset_source_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_candidate_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="XML"
                android:textColor="@color/candidate_text_highlight"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_preset_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_candidate_chip"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Aktif (Terpasang)"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
