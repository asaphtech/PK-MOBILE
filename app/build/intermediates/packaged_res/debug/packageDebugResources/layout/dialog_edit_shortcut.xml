<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✏️ Edit Shortcut"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ubah kata kunci trigger atau isi teks ekspansi."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Trigger Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColorHint="@color/text_secondary"
        app:boxStrokeColor="@color/accent"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditTrigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trigger / Kata Kunci (misal: /otosc)"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Expansion Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/text_secondary"
        app:boxStrokeColor="@color/accent"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditExpansion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Teks Ekspansi Pengganti (Mendukung banyak baris)"
            android:inputType="textMultiLine"
            android:minLines="5"
            android:maxLines="12"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mode Ekspansi Teks"
        android:textColor="@color/candidate_text_highlight"
        android:textSize="12sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_edit_expansion_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/rb_edit_mode_instant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instan / Tanpa Spasi (e.g. /id langsung ekspansi)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_edit_mode_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dengan Spasi / Enter (e.g. /id menunggu spasi/enter)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:backgroundTint="@color/accent"
            android:text="Simpan Perubahan"
            android:textColor="@color/text_primary"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
