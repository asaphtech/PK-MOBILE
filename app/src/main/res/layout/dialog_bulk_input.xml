<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Judul Dialog -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 Bulk Input (Tempel dari Notepad)"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Format Guide -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Format per baris: /trigger = Teks Pengganti"
        android:textColor="@color/candidate_text_highlight"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Mendukung pemisah: '=' , '->' , atau Tab. Gunakan \\n untuk baris baru dalam teks."
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Multi-line EditText berukuran besar -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColorHint="@color/text_secondary"
        app:boxStrokeColor="@color/accent"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_bulk_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Contoh:\n/otosc = Halo bosku, pesanan sedang diproses\n/gantirek -> Silahkan transfer ke BCA 12345\n/thx\tTerima kasih banyak!"
            android:minLines="8"
            android:maxLines="16"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/key_text_secondary"
            android:textSize="13sp"
            android:inputType="textMultiLine|textNoSuggestions" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Pratinjau Deteksi -->
    <TextView
        android:id="@+id/tv_bulk_preview_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Pratinjau: 0 shortcut terdeteksi"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bulk_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bulk_process"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:backgroundTint="@color/accent"
            android:text="Proses &amp; Simpan Ke Database"
            android:textColor="@color/text_primary"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
